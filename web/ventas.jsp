<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nueva venta</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="resources/css/styles.css"></head><body><main class="container py-4"><h2>Registrar venta</h2><div class="row g-4 mt-2"><section class="col-md-8"><div class="card p-3"><label>Cliente</label><input class="form-control mb-3" placeholder="DNI/RUC o nombre"><label>Producto</label><div class="input-group"><input class="form-control" placeholder="Código o producto"><button class="btn btn-danger">Agregar</button></div><table class="table mt-4"><thead><tr><th>Producto</th><th>Cant.</th><th>Precio</th></tr></thead><tbody id="detalle"></tbody></table></div></section><aside class="col-md-4"><div class="card p-3"><h4>Resumen</h4><p>Total: <strong id="total">S/ 0.00</strong></p><button class="btn btn-danger w-100" onclick="confirmarVenta()">Confirmar venta</button></div></aside></div></main><script src="resources/js/app.js"></script></body></html>