<%@ page contentType="text/html;charset=UTF-8" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SISCOM - Login</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="resources/css/styles.css"></head>
<body class="login-bg"><main class="container min-vh-100 d-flex align-items-center justify-content-center"><form action="login" method="post" class="card shadow p-4 login-card"><h2 class="mb-4">Acceso a SISCOM</h2><div class="mb-3"><label class="form-label">Correo</label><input class="form-control" name="correo" type="email" required></div><div class="mb-3"><label class="form-label">Contraseña</label><input class="form-control" name="clave" type="password" required></div><button class="btn btn-danger w-100">Ingresar</button><p class="text-danger mt-3">${error}</p></form></main></body></html>